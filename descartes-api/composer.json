{
    "name": "descartes/api",
    "description": "Descartes 2.0 REST API",
    "type": "project",
    "require": {
        "php": "^8.0",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Descartes\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Descartes\\Api\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}