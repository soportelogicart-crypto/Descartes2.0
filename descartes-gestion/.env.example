# Desarrollo sin build: Vite reenvía /api (vite.config.ts).
# VITE_API_BASE_URL=

# --- XAMPP local (SQL Server LOGIA_DEMO) ---
# VITE_API_PROXY_TARGET=http://localhost
# VITE_API_PROXY_PATH=/descartes-api-dev/public/api

# --- BD demo en Hostinger (misma API que gestion.topay-comunicacion.es) ---
# VITE_API_PROXY_TARGET=https://gestion.topay-comunicacion.es
# VITE_API_PROXY_PATH=/api-descartes/public/api
# Ver también .env.hosting-demo.example

# Solo si el frontend llama a la API directamente (requiere CORS_ORIGINS en la API):
# VITE_API_BASE_URL=http://localhost/descartes-api-dev/public

# Servidor PHP integrado (sin XAMPP):
# VITE_API_BASE_URL=http://127.0.0.1:8080

# Build hosting (npm run build): VITE_API_BASE_URL vacío y VITE_BASE=/ — las peticiones van a /api y proxy.php.
# Tras build, copiar public/proxy.php a dist/proxy.php antes de subir dist/.
